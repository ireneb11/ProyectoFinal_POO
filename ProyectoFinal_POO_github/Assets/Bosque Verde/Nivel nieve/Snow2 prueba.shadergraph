{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "d454528fe5e840748cdff9773bdeb1c9",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "CalculateHeight (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -568.0029296875,
            "y": -79.82270812988281,
